# Copy to .env and fill in. .env is gitignored - never commit real credentials.
#
#   cp .env.example .env
#
# Locally you can ignore everything except PORT: with no Azure credentials the
# app falls back to flat files under DATA_DIR.

# ---------------------------------------------------------------- app settings
PORT=3000

# Where local JSON files live when STORAGE_BACKEND=local.
DATA_DIR=./data

# Set to true only when the app is served over HTTPS (i.e. on Azure).
# Leave false for plain-HTTP local/LAN use, or the browser will silently refuse
# the session cookie and you'll be stuck in a login loop.
COOKIE_SECURE=false

# Optional. If set, this wins over the "password" field in settings.json.
# Preferred on Azure so the secret lives in app configuration, not in a blob.
SCHEDULE_PASSWORD=

# Optional. Signs the session cookie. If set, it wins over the generated
# "sessionSecret" in settings.json.
#
# Set BOTH this and SCHEDULE_PASSWORD and settings.json is never created or read
# at all - auth becomes purely configuration-driven, which is what you want on
# Azure. Leave both blank locally and settings.json is generated for you.
#
# Generate one with:  openssl rand -hex 32
# Changing it logs everyone out.
SESSION_SECRET=

# ------------------------------------------------------------------- storage
# local | azure-blob
# If left blank, azure-blob is inferred when credentials below are present,
# otherwise local.
STORAGE_BACKEND=local

# ---------------------------------------------- Azure Storage (placeholders)
# Either provide the connection string (simplest) ...
AZURE_STORAGE_CONNECTION_STRING=

# ... or the account name + key.
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# The blob container that holds swaps.json and settings.json.
# Created automatically on startup if it doesn't exist.
AZURE_STORAGE_CONTAINER=schedule-data
