# Copy to terraform.tfvars and edit. *.tfvars is gitignored - it holds secrets.
#
#   cp terraform.tfvars.example terraform.tfvars

# Required. The password for the app's login page (min 8 chars).
schedule_password = "change-me-to-something-real"

# Optional. Leave unset to have one generated and stored in Terraform state.
# Set it explicitly to keep sessions alive across state rebuilds.
#   openssl rand -hex 32
# session_secret = ""

# Feeds resource names; 3-12 lowercase letters/digits.
name_prefix = "schedulegen"

location = "eastus"

# The specific blob container for the app's JSON documents.
storage_container_name = "schedule-data"

# 0 = scale to zero when idle (cheapest, few seconds' cold start on next request)
# 1 = always warm, billed continuously
min_replicas = 0

# Pinned to 1 in main.tf regardless - see the comment there before changing.
# cpu    = 0.25
# memory = "0.5Gi"
